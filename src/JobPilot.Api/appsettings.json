{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=jobpilot_dev;Username=postgres;Password=postgres;"
  },
  "Ai": {
    "Enabled": false,
    "Provider": "None",
    "Model": "claude-3-5-sonnet",
    "TimeoutSeconds": 30,
    "MaxFieldsPerCall": 25,
